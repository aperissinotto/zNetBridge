#include "zncnfh.h"
#include "znstoh.h"

void* zn_alloc(size_t size) {
    void* allocated_addr = NULL;
    if (size == 0) return NULL;
    __asm (
        " L     0,%1              \n"
        " STORAGE OBTAIN,LENGTH=(0),SP=0,LOC=ANY \n"
        " ST    1,%0              \n"
        : "=m"(allocated_addr)
        : "m"(size)
        : "r0", "r1", "r14", "r15"
    );
    return allocated_addr;
}

void* zn_zalloc(size_t size) {
    void* ptr = zn_alloc(size);
    if (ptr != NULL) {
        memset(ptr, 0, size);
    }
    return ptr;
}

void zn_free(void* ptr, size_t size) {
    if (!ptr || size == 0) return;
    __asm (
        " L     0,%0              \n"
        " L     1,%1              \n"
        " STORAGE RELEASE,LENGTH=(0),ADDR=(1),SP=0 \n"
        :
        : "m"(size), "m"(ptr)
        : "r0", "r1", "r14", "r15"
    );
}
